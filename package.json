{
  "name": "smee.io",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.scss"
  ],
  "description": "Receives payloads then sends them to your locally running application.",
  "author": "Jason Etcovitch <jasonetco@gmail.com> (https://github.com/JasonEtco)",
  "license": "ISC",
  "repository": "github:probot/smee.io",
  "scripts": {
    "start": "node ./index.js",
    "start-dev": "concurrently \"nodemon --ignore src/ ./index.js\" \"webpack -w --mode development\"",
    "build": "webpack",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "redis:start": "docker run -d -p 6379:6379 --name probot-redis --rm redis",
    "redis:stop": "docker stop probot-redis",
    "test": "npm run build:production && npm run test:server && npm run test:browser",
    "build:production": "NODE_ENV=production npm run build",
    "test:server": "node --test --test-timeout=15000 tests/server/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@sentry/node": "^11.9.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@microlink/react-json-view": "^1.31.42",
    "@playwright/test": "^1.64.1",
    "@primer/css": "^22.3.2",
    "@primer/octicons-react": "^19.41.0",
    "@primer/primitives": "^11.10.0",
    "@primer/view-components": "^0.53.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "compression-webpack-plugin": "^12.0.0",
    "concurrently": "^10.0.6",
    "copy-to-clipboard": "^4.0.2",
    "css-loader": "^7.1.5",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.13.0",
    "eventsource": "^5.1.3",
    "get-value": "^4.1.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "neostandard": "^0.14.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.31",
    "postcss-loader": "^8.2.1",
    "purgecss-webpack-plugin": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.106.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "tinyglobby": "^0.2.17",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3"
  },
  "engines": {
    "node": ">=24"
  }
}
